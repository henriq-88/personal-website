{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "clean": {
      "cache": false
    },
    "clean:all": {
      "cache": false
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "type-check": {
      "cache": false
    }
  },
  "globalEnv": [
    "ANALYZE",
    "NEXT_PUBLIC_GIT_HASH",
    "NODE_ENV",
    "PORT",
    "SENDGRID_API_KEY",
    "SKIP_ENV_VALIDATION",
    "VERCEL_URL",
    "VERCEL"
  ]
}
